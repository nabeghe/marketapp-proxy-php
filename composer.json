{
    "name": "nabeghe/marketapp-proxy",
    "description": "High-performance reverse proxy for MarketApp API in PHP (compatible with PHP 7.4 - 8.5)",
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/nabeghe/marketapp-proxy-php",
    "authors": [
        {
            "name": "Hadi Akbarzadeh",
            "email": "elsiomcoder@gmail.com",
            "homepage": "https://elatel.ir",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.4.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nabeghe\\MarketAppProxy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nabeghe\\MarketAppProxy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
